# ───────────────────────────────────────────────────────────────────────────────
# J.A.R.V.I.S. — Environment Configuration Template
# Copy this file to .env.local and fill in your values
# Do NOT commit .env.local — it contains secrets!
# ───────────────────────────────────────────────────────────────────────────────

# LiveKit Server (running locally via Docker on your PC)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Ollama — Local LLM (https://ollama.com)
# Change to gemma3:12b or gemma3:27b if your GPU can handle it
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Kokoro TTS — Local voice server (running via Docker on port 8880)
# Voices: af_heart (warm), af_sky (bright), bf_emma (British female), bm_lewis (British male)
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_VOICE=bm_lewis

# Whisper STT — Local speech recognition
WHISPER_BASE_URL=http://localhost:9000/v1

# Room name for Android app to join
ROOM_NAME=jarvis-room
